# Sao chép thành .env rồi đổi MỌI giá trị change-me. KHÔNG commit .env.

# ---------- Database ----------
POSTGRES_DB=nursery
POSTGRES_USER=nursery_app
POSTGRES_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# ---------- Auth ----------
JWT_SECRET=change-me-it-nhat-32-ky-tu-ngau-nhien
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# ---------- MQTT ----------
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASSWORD=change-me
MQTT_DYNSEC_USER=dynsec-admin
MQTT_DYNSEC_PASSWORD=change-me
# Địa chỉ IP máy server trong LAN, thiết bị dùng để kết nối
MQTT_PUBLIC_HOST=192.168.1.10

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=change-me

# ---------- AI ----------
AI_URL=http://ai:8000
AI_CONF_UNKNOWN=0.6
AI_CONF_ALERT=0.8

# ---------- Lưu trữ ----------
IMAGE_DIR=/data/images
RETENTION_TELEMETRY_DAYS=30
RETENTION_IMAGES_DAYS=14

# ---------- Seed (backend dùng lúc khởi tạo lần đầu để tạo 3 tài khoản) ----------
SEED_ADMIN_PASSWORD=change-me
SEED_OPERATOR_PASSWORD=change-me
SEED_VIEWER_PASSWORD=change-me

# ---------- Web ----------
PUBLIC_ORIGIN=https://192.168.1.10
