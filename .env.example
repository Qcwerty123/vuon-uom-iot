# Sao chép thành .env rồi đổi MỌI giá trị change-me. KHÔNG commit .env.
# Chạy trực tiếp trên máy Windows (đặc tả §17, C21). Đường dẫn tương đối tính từ gốc repo.

# ---------- Database (PostgreSQL portable trong tools/pgsql, dữ liệu runtime/pgdata) ----------
PG_SUPERUSER_PASSWORD=change-me   # Mật khẩu tài khoản superuser postgres của cụm cục bộ
POSTGRES_DB=nursery
POSTGRES_USER=nursery_app
POSTGRES_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5433                     # 5432 bị Windows giữ (excluded port range) trên máy demo
PGDATA_DIR=runtime/pgdata

# ---------- Auth ----------
JWT_SECRET=change-me-it-nhat-32-ky-tu-ngau-nhien
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# ---------- MQTT ----------
# Backend chạy cùng máy với broker
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASSWORD=change-me
MQTT_DYNSEC_USER=dynsec-admin
MQTT_DYNSEC_PASSWORD=change-me
# Địa chỉ thiết bị dùng để kết nối: IP máy chủ trên Mobile Hotspot của Windows (C17)
MQTT_PUBLIC_HOST=192.168.137.1

# ---------- Backend ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=change-me

# ---------- AI (chỉ nghe máy chủ) ----------
AI_URL=http://127.0.0.1:8001
AI_MODEL_DIR=runtime/ai/models
AI_CONF_UNKNOWN=0.6
AI_CONF_ALERT=0.8

# ---------- Lưu trữ và log ----------
IMAGE_DIR=runtime/images
BACKUP_DIR=runtime/backups
LOG_DIR=logs/services
RETENTION_TELEMETRY_DAYS=30
RETENTION_IMAGES_DAYS=14

# ---------- Seed (backend dùng lúc khởi tạo lần đầu để tạo 3 tài khoản) ----------
SEED_ADMIN_PASSWORD=change-me
SEED_OPERATOR_PASSWORD=change-me
SEED_VIEWER_PASSWORD=change-me

# ---------- Web ----------
# Demo chạy HTTP; HTTPS (cổng 8443, mkcert) là tùy chọn — C5
PUBLIC_ORIGIN=http://192.168.137.1:8000
